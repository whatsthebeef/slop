{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "mcp__slop__*",
      "mcp__claude_ai_Slop__*",
      "Bash(git push origin s*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "slop"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/slop_after_push.sh"
          }
        ]
      }
    ]
  }
}
